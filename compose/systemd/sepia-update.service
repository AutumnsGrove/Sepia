[Unit]
Description=Sepia update watcher (one shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The operator account, never root: the script runs one fixed sequence (git pull, one compose pull and one compose
# up, a health check) and root would add blast radius without adding a capability it needs.
User=@USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/compose/watcher/update.sh
# Above the script's real worst case, so systemd never SIGKILLs it between a failed start and its rollback and
# leaves requested behind: resolve 60s + git 60s + pull 300s + up 60s + health 40x(6+3)s = 360s + logs 20s +
# rollback up 60s + rollback health 360s, which is 1280s. The health poll is the expensive one because a container
# that accepts connections but never answers costs a full curl timeout on every try.
TimeoutStartSec=1800
